# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Port the addon listens on.
PORT="8080"

# Interface the addon binds to. Use 127.0.0.1 to keep it local-only.
HOST="0.0.0.0"

# Milliseconds to wait for in-flight requests and cleanup on shutdown.
FASTIFY_CLOSE_GRACE_DELAY="10000"

# Pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL="info"

# "development" | "production" | "test".
# Publishing to Stremio Central only happens when NODE_ENV="production".
NODE_ENV="development"

# Logo shown in the Stremio addon page. Empty = the bundled artwork.
LOGO_URL=""

# Stremio Central publishing URL. Only used when NODE_ENV="production".
CENTRAL_URL=""

# Sentry error tracking. Empty = disabled (SDK no-ops, logs only).
SENTRY_DSN=""
# Defaults to NODE_ENV when empty.
SENTRY_ENVIRONMENT=""
# 0.0 - 1.0, share of transactions traced.
SENTRY_TRACES_SAMPLE_RATE="0.1"
