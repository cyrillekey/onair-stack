<%- include('../layout/header') %>
<%
  // Look up an option group by name; fail with a clear message if the server didn't supply it.
  const findGroup = function (name) {
    const group = groups.find(function (g) { return g.name === name; });
    if (!group) throw new Error('configure/index: missing option group "' + name + '"');
    return group;
  };

  // Zero-padded counter: step markers, preview counts, rail numbers.
  const pad = function (n) { return String(n).padStart(2, "0"); };

  const shared = {
    countries: findGroup("countries"),
    genres: findGroup("categories"),
    pad: pad
  };
%>
<main class="configure-page" data-configure>
  <h1 class="sr-only">Configure your line-up</h1>
  <section class="builder wrap" aria-label="Line-up builder">
    <%- include('builder-form', shared) %>
    <%- include('preview', shared) %>
  </section>
</main>
<%- include('../layout/footer') %>
