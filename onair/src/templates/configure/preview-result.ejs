<div class="preview-result" data-preview-result hidden>
  <div class="preview-result-head">
    <span>Your install link</span>
    <span class="preview-result-status"><i aria-hidden="true"></i> Ready</span>
  </div>
  <div class="preview-url">
    <code data-manifest-url></code>
  </div>
  <div class="preview-result-actions">
    <button type="button" data-copy-link>
      <%- include('./icon', { name: "copy", size: 13 }) %>
      <span data-copy-label>Copy link</span>
    </button>
    <a data-open-stremio href="#" target="_blank" rel="noopener">
      <%- include('./icon', { name: "play", size: 13 }) %>
      Open in Stremio
    </a>
  </div>
  <p class="preview-result-hint">Stremio → Add-ons → Install from URL.</p>
</div>
