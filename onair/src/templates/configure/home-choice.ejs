<%
  // Radio options for where catalog rails appear in Stremio. The `checked` one is the default.
  const choices = [
    {
      value: "true",
      title: "On the home screen",
      description: "Your catalog rails appear on the Stremio Board.",
      badge: "Recommended",
      checked: true
    },
    {
      value: "false",
      title: "Discover only",
      description: "Keep the Board quiet and browse from Discover."
    }
  ];
%>
<fieldset class="choice-field">
  <legend class="sr-only">Stremio home screen placement</legend>
  <div class="choice-grid">
    <% choices.forEach(function (choice) { %>
    <label class="choice-card<%= choice.checked ? " is-selected" : "" %>">
      <input type="radio" name="showOnHome" value="<%= choice.value %>"<%= choice.checked ? " checked" : "" %>>
      <span class="choice-dot" aria-hidden="true"></span>
      <span class="choice-copy">
        <span class="choice-title"><%= choice.title %></span>
        <span class="choice-desc"><%= choice.description %></span>
        <% if (choice.badge) { %>
        <span class="choice-badge"><%= choice.badge %></span>
        <% } %>
      </span>
    </label>
    <% }); %>
  </div>
</fieldset>
