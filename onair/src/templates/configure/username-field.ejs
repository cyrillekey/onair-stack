<div class="field">
  <label class="field-label" for="username">Username</label>
  <div class="text-control">
    <span class="text-prefix" aria-hidden="true">@</span>
    <input class="text-input" id="username" name="username" type="text" maxlength="32" placeholder="your name" autocomplete="nickname" spellcheck="false" required aria-describedby="username-hint username-error" data-username>
  </div>
  <p class="field-hint" id="username-hint">Up to 32 characters. No account needed.</p>
  <p class="field-error" id="username-error" data-error="username" role="alert" hidden></p>
</div>
