// use prisma-8
model User {
  id            String         @id @default(sql`gen_random_uuid()`)
  name          String?
  country       String?
  configuration Configuration?
  createdat     DateTime       @default(now())
  updatedat     DateTime       @default(now())

  @@map("users")
}

model Configuration {
  id         String     @id @default(sql`gen_random_uuid()`)
  countries  String[]
  categories Category[]
  timezone   String
  showInHome Boolean    @default(false)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String     @unique
  createdat  DateTime   @default(now())
  updatedat  DateTime   @default(now())

  @@map("configuration")
}

model Channel {
  id          String     @id @default(sql`gen_random_uuid()`)
  name        String
  category    Category   @default(GENERAL)
  description String?
  country     String
  slug        String     @unique
  poster      String?
  streams     Stream[]
  externalId  String?
  schedule    Schedule[]
  createdat   DateTime   @default(now())
  updatedat   DateTime   @default(now())

  @@map("channel")
}

model Stream {
  id                String    @id @default(sql`gen_random_uuid()`)
  name              String
  resolution        String?
  slug              String    @unique
  url               String
  language          String
  youtubeId         String?
  /// Consecutive failed health passes. Reset to 0 on a successful check.
  failureCount      Int       @default(0)
  /// First failure of the current streak; null while healthy. Operational
  /// marker for how long the stream has been unreachable.
  unreachableAt     DateTime?
  /// Most recent verification error, for ops/debugging.
  lastFailureReason String?
  channel           Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId         String
  createdat         DateTime  @default(now())
  updatedat         DateTime  @default(now())

  @@map("stream")
}

model Schedule {
  id          String   @id @default(sql`gen_random_uuid()`)
  name        String
  poster      String?
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  description String?
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String
  createdat   DateTime @default(now())
  updatedat   DateTime @default(now())

  @@unique([channelId, date, startTime])
  @@map("schedule")
}

/// Channel category taxonomy (16 values).
/// Values match the `category` field in channel_classified.json exactly.
enum Category {
  ADULT
  ADVENTIST
  ANIME
  BASEBALL
  BASKETBALL
  BUSINESS
  CATHOLIC
  CHRISTIAN
  CLASSIC_TV
  COMBAT_SPORTS
  COMEDY
  CRICKET
  CRIME
  DOCUMENTARY
  DRAMA
  EDUCATION
  ENTERTAINMENT
  FASHION
  FOOD
  FOOTBALL
  GENERAL
  GOSPEL
  INTERNATIONAL
  ISLAMIC
  JEWISH
  KIDS
  LIFESTYLE
  LOCAL
  MOTORSPORTS
  MOVIES
  MUSIC
  NEWS
  OUTDOORS_AUTO
  PRAISE_WORSHIP
  RADIO
  REALITY_TV
  RELIGIOUS
  SCIENTOLOGY
  SHOPPING
  SPORTS
  TECHNOLOGY
  TRAVEL
}

