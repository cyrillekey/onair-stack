// use prisma-8
model User {
  id          String     @id @default(sql`gen_random_uuid()`)
  name String?
  configuration Configuration
  createdat   DateTime   @default(now())
  updatedat   DateTime   @default(now())
  @@map("users")
}

model Configuration {
  id          String     @id @default(sql`gen_random_uuid()`)
  countries   String []
  categories  Category []
  user User @relation(fields: [userId],references: [id],onDelete:Cascade)
  userId String
  createdat   DateTime   @default(now())
  updatedat   DateTime   @default(now())
  @@map("configuration")
}


model Channel {
  id          String     @id @default(sql`gen_random_uuid()`)
  name        String
  category    Category   @default(GENERAL)
  description String?
  country     String
  slug        String     @unique
  poster      String?
  streams     Stream[]
  externalId  String?
  schedule    Schedule[]
  createdat   DateTime   @default(now())
  updatedat   DateTime   @default(now())

  @@map("channel")
}

model Stream {
  id                String   @id @default(sql`gen_random_uuid()`)
  name              String
  resolution        String?
  slug              String    @unique
  url               String
  language          String
  youtubeId         String?
  /// Consecutive failed health passes. Reset to 0 on a successful check.
  failureCount      Int       @default(0)
  /// First failure of the current streak; null while healthy. Operational
  /// marker for how long the stream has been unreachable.
  unreachableAt     DateTime?
  /// Most recent verification error, for ops/debugging.
  lastFailureReason String?
  channel           Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId         String
  createdat         DateTime  @default(now())
  updatedat         DateTime  @default(now())

  @@map("stream")
}

model Schedule {
  id          String   @id @default(sql`gen_random_uuid()`)
  name        String
  poster      String?
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  description String?
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String
  createdat   DateTime @default(now())
  updatedat   DateTime @default(now())

  @@unique([channelId, date, startTime])
  @@map("schedule")
}

/// Channel category taxonomy (16 values).
/// Values match the `category` field in channel_classified.json exactly.
enum Category {
  /// General networks, scripted and reality TV (ITV, BBC One, TNT, Lifetime)
  ENTERTAINMENT
  /// beIN, NBA League Pass, regional sports networks, ESPN, Fox Sports
  SPORTS
  /// Movie channels and premium multiplexes (HBO, Cinemax, Starz, Showtime, MGM+)
  MOVIES
  /// News, business news, weather, international news
  NEWS
  /// Foreign-language / diaspora general channels (Univision, Telemundo, KBS, Zee)
  INTERNATIONAL
  /// Audio-only stations (BBC radio, Heart, Capital, LBC, talkSPORT)
  RADIO
  /// Faith-based networks (EWTN, TBN, 3ABN, Daystar)
  RELIGIOUS
  /// Factual and educational (Discovery, Nat Geo, History, Curiosity, Quest)
  DOCUMENTARY
  /// Music video and music-focused channels (Vevo, MTV, VH1, AXS TV)
  MUSIC
  /// Children's channels (Nickelodeon, Disney, Cartoon Network, CBBC)
  KIDS
  /// Home shopping (QVC, HSN, Jewelry Television, Ideal World)
  SHOPPING
  /// Food, home, travel, pets (Food Network, HGTV, Tastemade)
  LIFESTYLE
  /// Classic and retro TV (MeTV, Antenna TV, TV Land, Rewind)
  CLASSIC_TV
  /// True crime and justice (Court TV, Investigation Discovery, Law and Crime)
  CRIME
  /// Adult content (Playboy, Hustler, Penthouse)
  ADULT
  /// Outdoors, hunting, fishing and motoring (Outdoor Channel, MotorTrend)
  OUTDOORS_AUTO
  /// Fallback category
  GENERAL
}
