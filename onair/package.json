{
  "name": "stremio-addon-onair",
  "version": "0.0.1",
  "description": "Live tv",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx src/server.ts --launch",
    "build": "rimraf dist && tsc && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/src/server.js",
    "contract:emit": "prisma contract emit"
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "@sentry/node": "^11.0.0",
    "@sentry/profiling-node": "^11.0.0",
    "dotenv": "^18.0.3",
    "stremio-addon-sdk": "https://github.com/Stremio/stremio-addon-sdk.git",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@prisma/cli-engine": "^0.6.1",
    "@types/node": "^22.10.0",
    "@types/stremio-addon-sdk": "^1.6.12",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prisma": "^8.0.0-rc.17",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  }
}