{
  "name": "onai-fast",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "npm run build && node --enable-source-maps dist/src/server.js",
    "build": "npm run build:ts",
    "build:ts": "tsc && tsc-alias -p tsconfig.json",
    "dev": "fastify start -w -l info -P -r tsx/cjs src/app.ts",
    "emit": "prisma contract emit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "@prisma/orm-postgres": "^8.0.0-rc.20",
    "@scalar/fastify-api-reference": "^1.76.0",
    "@sentry/node": "^11.9.0",
    "@sentry/profiling-node": "^11.9.0",
    "close-with-grace": "^2.5.0",
    "countries-and-timezones": "^3.11.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "html-minifier-terser": "^7.2.0",
    "stremio-addon-sdk": "https://github.com/Stremio/stremio-addon-sdk.git",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.0.8",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "eslint": "^10.13.0",
    "fastify-tsconfig": "^3.0.0",
    "globals": "^17.13.0",
    "prisma": "^8.0.0-rc.27",
    "ts-node": "^10.4.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1"
  }
}
