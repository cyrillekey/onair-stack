{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "outDir": "dist",
     "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "noEmitOnError": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "prisma.config.ts"]
}
