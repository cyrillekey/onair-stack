# Copy to `.env` next to docker-compose.yml to override the defaults.
# Every value is optional — the compose file falls back to the defaults below.

# --- Database -----------------------------------------------------------
POSTGRES_USER=onair
POSTGRES_PASSWORD=onair
POSTGRES_DB=onair
# Host port for Postgres (remove the port mapping in docker-compose.yml to
# keep the database internal to the compose network).
POSTGRES_PORT=5432

# --- Addon (onair) ------------------------------------------------------
# Host port the addon is served on: http://localhost:8080/manifest.json
ONAIR_PORT=8080
# Logo shown in the Stremio addon page.
LOGO_URL=
# Stremio Central publishing URL. Only used when NODE_ENV=production.
CENTRAL_URL=

# --- Collector ----------------------------------------------------------
# IANA timezone the cron schedules are evaluated in.
TZ=UTC
LOG_LEVEL=info
# true = run every enabled job once and exit (use with an external scheduler).
RUN_ONCE=false
# Restart policy for the worker. Set it to "no" together with RUN_ONCE=true,
# otherwise Docker keeps restarting the finished one-shot pass.
COLLECTOR_RESTART=unless-stopped
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=onair-collector/0.0.1
STREAM_HEALTH_BATCH_SIZE=20
STREAM_HEALTH_TIMEOUT_MS=15000
STREAM_HEALTH_DEEP_CHECK=true
STREAM_HEALTH_MAX_DELETE_RATIO=0.9
# Cronitor monitoring key for the worker's cron jobs.
CRONITOR_API_KEY=
# Cloudinary, used to host channel artwork.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observability (both services) --------------------------------------
# Empty = Sentry disabled (errors are only logged).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=1
