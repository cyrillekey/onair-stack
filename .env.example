# Copy to `.env` next to docker-compose.yml to override the defaults.
# Every value is optional — the compose file falls back to the defaults below.
# The values below are the same defaults the collector and the addon use when
# they run outside Docker, so the stack behaves identically in both setups.

# --- Database -----------------------------------------------------------
POSTGRES_USER=onair
POSTGRES_PASSWORD=onair
POSTGRES_DB=onair
# Host port for Postgres (remove the port mapping in docker-compose.yml to
# keep the database internal to the compose network).
POSTGRES_PORT=5432

# --- Addon (onair) ------------------------------------------------------
# Host port the addon is served on: http://localhost:8080/manifest.json
ONAIR_PORT=8080
# Logo shown in the Stremio addon page. Empty = the bundled artwork.
LOGO_URL=
# Stremio Central publishing URL. Only used when NODE_ENV=production.
CENTRAL_URL=
# Public hostname for the optional HTTPS proxy (compose profile "proxy").
# Empty = localhost (Caddy then issues a locally-trusted certificate).
ONAIR_DOMAIN=

# --- Collector ----------------------------------------------------------
# IANA timezone the cron schedules are evaluated in.
TZ=UTC
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true = run every enabled job once and exit (use with an external scheduler).
RUN_ONCE=false
# Restart policy for the worker. Set it to "no" together with RUN_ONCE=true,
# otherwise Docker keeps restarting the finished one-shot pass.
COLLECTOR_RESTART=unless-stopped
# Per-request timeout (ms) for the crawler's HTTP calls.
HTTP_TIMEOUT_MS=15000
# Retries per failed HTTP request (0-10).
HTTP_MAX_RETRIES=3
# User-Agent sent with every crawler request.
HTTP_USER_AGENT=onair-collector/0.0.1
# Cron expression for the stream-health pruning job (every 30 minutes).
STREAM_HEALTH_CRON="*/30 * * * *"
# How many streams to verify / delete per batch.
STREAM_HEALTH_BATCH_SIZE=20
# Per-stream verification timeout (ms).
STREAM_HEALTH_TIMEOUT_MS=15000
# true = verify one level past the playlist (variant/segment reachable).
STREAM_HEALTH_DEEP_CHECK=true
# Safety trip: delete nothing if more than this share (0-1) of checked
# streams looks broken (likely an outage on our side, not dead sources).
STREAM_HEALTH_MAX_DELETE_RATIO=0.5
# Cronitor monitoring key for the worker's cron jobs (empty = disabled).
CRONITOR_API_KEY=
# Cronitor environment label for the monitors, e.g. "production".
# Empty = the Cronitor account default.
CRONITOR_ENVIRONMENT=
# Cronitor region, e.g. "eu". Empty = the Cronitor default region.
CRONITOR_REGION=
# Cloudinary, used to host channel artwork.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observability (both services) --------------------------------------
# Empty = Sentry disabled (errors are only logged).
SENTRY_DSN=
# Sentry environment. Empty = falls back to the service's NODE_ENV.
SENTRY_ENVIRONMENT=
# 0.0 - 1.0, share of transactions traced.
SENTRY_TRACES_SAMPLE_RATE=0.1
