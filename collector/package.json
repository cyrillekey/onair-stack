{
  "name": "onair-collector",
  "version": "0.0.1",
  "description": "Cron-driven JSON/HTML scraper worker. No HTTP server, writes to Postgres.",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:once": "RUN_ONCE=true tsx src/main.ts",
    "build": "rimraf dist && tsc && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:playlist": "tsx src/utils/playlist.validator.ts",
    "start": "node dist/src/main.js",
    "start:once": "RUN_ONCE=true node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@logtail/pino": "^0.5.12",
    "@prisma/orm-postgres": "^8.0.0-rc.18",
    "@sentry/node": "^11.6.0",
    "@sentry/profiling-node": "^11.6.0",
    "cheerio": "^1.0.0",
    "cloudinary": "^2.11.0",
    "cronitor": "^2.6.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.3",
    "fast-xml-parser": "^5.11.2",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "progress": "^2.0.3",
    "similarity": "^1.2.1",
    "temporal-polyfill": "^1.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/progress": "^2.0.7",
    "@types/similarity": "^1.2.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^8.0.0-rc.23",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.0.0"
  }
}
