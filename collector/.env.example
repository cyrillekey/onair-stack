# Copy to `.env`
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"



# When true, run every enabled job once and exit.
# Useful for Kubernetes CronJobs / one-shot runs.
RUN_ONCE="false"

# Comma-separated job names to enable. Empty = all registered jobs.
# Example: ENABLED_JOBS="example-json,example-html"
ENABLED_JOBS=""

# Timezone for cron evaluation (IANA name).
TZ="UTC"

LOG_LEVEL="info"
HTTP_TIMEOUT_MS="15000"
HTTP_MAX_RETRIES="3"
HTTP_USER_AGENT="onair-collector/0.0.1"

# Stream health pruning: re-verify saved streams, delete broken links.
# Runs daily at 04:00 UTC by default (between the 00:00 and 08:00 ingests).
STREAM_HEALTH_CRON="0 4 * * *"
# How many streams to verify / delete concurrently.
STREAM_HEALTH_BATCH_SIZE="20"
# Per-stream verification timeout (ms).
STREAM_HEALTH_TIMEOUT_MS="15000"
# Verify one level past the playlist (variant/segment reachable).
STREAM_HEALTH_DEEP_CHECK="true"
# Safety trip: delete nothing if more than this share of checked
# streams looks broken (likely an outage on our side, not dead sources).
STREAM_HEALTH_MAX_DELETE_RATIO="0.9"
