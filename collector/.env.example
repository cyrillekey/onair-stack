# Copy to `.env`
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# "development" | "production" | "test".
# Also used as the Sentry environment when SENTRY_ENVIRONMENT is empty.
NODE_ENV="development"

# When true, run every enabled job once and exit.
# Useful for Kubernetes CronJobs / one-shot runs.
RUN_ONCE="false"

# Timezone for cron evaluation (IANA name).
TZ="UTC"

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Per-request timeout (ms) for HTTP calls.
HTTP_TIMEOUT_MS="15000"
# Retries per failed HTTP request (0-10).
HTTP_MAX_RETRIES="3"
# User-Agent sent with every request.
HTTP_USER_AGENT="onair-collector/0.0.1"

# Stream health pruning: re-verify saved streams, delete broken links.
# Cron expression for the job (every 30 minutes by default).
STREAM_HEALTH_CRON="*/30 * * * *"
# How many streams to verify / delete concurrently.
STREAM_HEALTH_BATCH_SIZE="20"
# Per-stream verification timeout (ms).
STREAM_HEALTH_TIMEOUT_MS="15000"
# Verify one level past the playlist (variant/segment reachable).
STREAM_HEALTH_DEEP_CHECK="true"
# Safety trip: delete nothing if more than this share (0-1) of checked
# streams looks broken (likely an outage on our side, not dead sources).
STREAM_HEALTH_MAX_DELETE_RATIO="0.5"

# Schedule retention: delete programme rows whose end time is older than
# this many days. Cron for the cleanup job (daily at 04:00 by default).
SCHEDULE_CLEANUP_CRON="0 4 * * *"
SCHEDULE_RETENTION_DAYS="4"

# Future overlap cleanup: when two or more future programmes overlap on the
# same channel, keep the newest ingested row and delete the older ones.
# Cron expression (daily at 03:30 by default).
SCHEDULE_OVERLAP_CLEANUP_CRON="30 3 * * *"

# Sentry error tracking. Empty = disabled (SDK no-ops, logs only).
SENTRY_DSN=""
# Defaults to NODE_ENV when empty.
SENTRY_ENVIRONMENT=""
# 0.0 - 1.0, share of transactions traced.
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Cronitor cron-job monitoring (empty = disabled).
# Each collector's job name is used directly as its Cronitor monitor key.
CRONITOR_API_KEY=""
# Environment label for the Cronitor monitors, e.g. "production".
# Empty = the Cronitor account default.
CRONITOR_ENVIRONMENT=""
# Cronitor region, e.g. "eu". Empty = the Cronitor default region.
CRONITOR_REGION=""

# Cloudinary, used to host channel artwork. Empty = uploads are skipped.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
